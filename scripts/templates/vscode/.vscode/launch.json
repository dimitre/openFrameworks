{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "C++ Launch (Debug)",
			"type": "lldb",
			"request": "launch",
			"program": "${workspaceFolder}/bin/${workspaceFolderBasename}_debug",
			"args": [],
			"cwd": "${workspaceFolder}",
			"stopOnEntry": false,
			"preLaunchTask": "Build DEBUG"
		},
		{
			"name": "C++ Launch (macOS Debug)",
			"type": "lldb",
			"request": "launch",
			"program": "${workspaceFolder}/bin/${workspaceFolderBasename}_debug.app/Contents/MacOS/${workspaceFolderBasename}_debug",
			"args": [],
			"cwd": "${workspaceFolder}",
			"stopOnEntry": false,
			"preLaunchTask": "Build DEBUG"
		},
		{
			"name": "C++ Launch (Windows Debug)",
			"type": "lldb",
			"request": "launch",
			"program": "${workspaceFolder}/bin/${workspaceFolderBasename}_debug.exe",
			"args": [],
			"cwd": "${workspaceFolder}",
			"stopOnEntry": false,
			"preLaunchTask": "Build DEBUG"
		},
		{
			"name": "C++ Attach",
			"type": "lldb",
			"request": "attach",
			"program": "${workspaceFolder}/bin/${workspaceFolderBasename}_debug",
			"pid": "${command:pickMyProcess}"
		}
	]
}
