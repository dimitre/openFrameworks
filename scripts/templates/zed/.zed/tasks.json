[
  {
    "label": "▶️ Run (chalet buildrun)",
    "command": "chalet buildrun",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never",
    "shell": "system",
    "show_summary": true
    // "show_output": true
  },

  {
    "label": "💾 Gen (ofgen templates=chalet)",
    "command": "ofgen templates=chalet",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never",
    "shell": "system",
    "show_summary": true
    // "show_output": true
  },

  {
    "label": "🫧 Clean (chalet clean --all)",
    "command": "chalet clean --all",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always
    "hide": "never",
    "shell": "system",
    "show_summary": true
    // "show_output": true
  },

  {
    "label": "💾 ▶️ Gen Run (ofgen templates=chalet buildrun)",
    "command": "ofgen templates=chalet buildrun",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never",
    "shell": "system",
    "show_summary": true
    // "show_output": true
  }

